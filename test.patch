+        setHeader: jest.fn(),
+      };
+
+      await compareHandler(req, res);
+
+      expect(res.status).toHaveBeenCalledWith(400);
+      expect(res.json).toHaveBeenCalledWith(
+        expect.objectContaining({
+          code: "MISSING_PARAMS",
+          message: expect.stringContaining("user1, user2"),
+        }),
+      );
+    });
+
+    it("should return 400 if only one user provided", async () => {
+      const req = { query: { user1: "alice" } };
+      const res = {
+        status: jest.fn().mockReturnThis(),
+        json: jest.fn(),
+        setHeader: jest.fn(),
+      };
+
