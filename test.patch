+/**
+ * Create mock GraphQL response for stats.
+ *
+ * @param {string} username Username.
+ * @param {Object} overrides Stats overrides.
+ * @returns {Object} Mock GraphQL response.
+ */
+const createMockStatsResponse = (
+  username,
+  { stars = 100, commits = 200, prs = 50, issues = 30, reviews = 20 } = {},
+) => ({
+  data: {
+    user: {
+      name: username,
+      login: username,
+      repositoriesContributedTo: { totalCount: 10 },
+      commits: { totalCommitContributions: commits },
+      reviews: { totalPullRequestReviewContributions: reviews },
+      pullRequests: { totalCount: prs },
+      mergedPullRequests: { totalCount: prs - 5 },
+      openIssues: { totalCount: Math.floor(issues / 2) },
+      closedIssues: { totalCount: Math.ceil(issues / 2) },
+      followers: { totalCount: 50 },
+      repositoryDiscussions: { totalCount: 5 },
+      repositoryDiscussionComments: { totalCount: 10 },
+      repositories: {
+        totalCount: 10,
+        nodes: [{ name: "repo1", stargazers: { totalCount: stars } }],
+        pageInfo: { hasNextPage: false, endCursor: null },
+      },
+    },
+  },
+});
+
+beforeEach(() => {
+  mock.reset();
+});
+
+afterEach(() => {
+  mock.reset();
+});
