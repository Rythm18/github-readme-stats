+// @ts-check
+
+if (!process.env.PAT_1) {
+  process.env.PAT_1 = "test_pat_token";
+}
+
+import {
+  describe,
+  expect,
+  it,
+  jest,
+  beforeEach,
+  afterEach,
+} from "@jest/globals";
+import axios from "axios";
+import MockAdapter from "axios-mock-adapter";
+import compareHandler from "../api/compare.js";
